PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Connection (from Supabase Database Settings > Connection string > URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Session details
JWT_SECRET=some-very-long-and-secure-random-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
BACKEND_URL=http://localhost:5000

# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
VAPID_PUBLIC_KEY=public-key-for-web-push
VAPID_PRIVATE_KEY=private-key-for-web-push
VAPID_EMAIL=noreply@tendrit.com

# Payment details encryption (AES-256-GCM) — encrypts provider bank account /
# routing numbers at the application layer. MUST be 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret and STABLE — rotating it makes existing ciphertext undecryptable.
PAYMENT_ENCRYPTION_KEY=64-hex-character-32-byte-key-change-in-prod

# Didit identity verification (business.didit.me > Workflows / API & Webhooks)
DIDIT_WORKFLOW_ID=your-didit-workflow-id
DIDIT_API_KEY=your-didit-api-key
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret